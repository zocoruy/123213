{
  "name": "sprintselect",
  "version": "0.1.0",
  "private": true,
  "description": "赛事照片本地筛选工具 · SprintSelect",
  "main": "dist-electron/electron/main.js",
  "author": "SprintSelect",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:desktop": "npm run build:electron && concurrently -k -s first \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build:electron": "tsc -p tsconfig.electron.json && node scripts/copy-assets.cjs",
    "build": "tsc -p tsconfig.json && vite build && npm run build:electron",
    "test": "vitest run electron",
    "test:e2e": "playwright test",
    "start": "electron .",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "dist:win:portable": "npm run build && electron-builder --win portable --x64"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "1.0.0",
    "exifr": "7.1.3",
    "lucide-react": "0.468.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "sharp": "0.34.3",
    "tesseract.js": "6.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@types/node": "22.18.6",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.3",
    "concurrently": "9.2.1",
    "cross-env": "10.0.0",
    "electron": "38.2.1",
    "electron-builder": "26.0.12",
    "resedit": "1.7.2",
    "typescript": "5.9.2",
    "vite": "7.1.7",
    "vitest": "3.2.4",
    "wait-on": "8.0.5"
  },
  "build": {
    "appId": "com.sprintselect.desktop",
    "productName": "SprintSelect",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/**/*"
    ],
    "afterPack": "scripts/brand-windows.cjs",
    "npmRebuild": false,
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "resources/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "artifactName": "SprintSelect-${version}-Setup-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "SprintSelect-${version}-Portable-${arch}.${ext}"
    }
  }
}
